{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace driveproof-attestor-simulator",
  "outputDirectory": "attestation/attestor-simulator/dist",
  "routes": [
    {
      "src": "/health",
      "dest": "/api/attestor.ts",
      "transforms": [{ "type": "request.path", "op": "set", "args": "/health" }]
    },
    {
      "src": "/provider-info",
      "dest": "/api/attestor.ts",
      "transforms": [{ "type": "request.path", "op": "set", "args": "/provider-info" }]
    },
    {
      "src": "/attest",
      "dest": "/api/attestor.ts",
      "transforms": [{ "type": "request.path", "op": "set", "args": "/attest" }]
    }
  ]
}
