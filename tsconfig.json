{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@driveproof/types": ["shared/types/src/index.ts"],
      "@driveproof/fixtures": ["shared/fixtures/src/index.ts"],
      "@driveproof/driveproof-client": ["shared/driveproof-client/src/index.ts"],
      "@driveproof/midnight-wallet": ["shared/midnight-wallet/src/index.ts"],
      "@driveproof/midnight-runtime": ["shared/midnight-runtime/src/index.ts"],
      "@driveproof/midnight-runtime/*": ["shared/midnight-runtime/src/*"],
      "@driveproof/attestor-client": ["shared/attestor-client/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "shared/**/*.ts",
    "preprod-cli/**/*.ts",
    "test/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
