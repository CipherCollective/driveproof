# Product apps intentionally default to the explicit local mock client.
VITE_DRIVEPROOF_CLIENT_MODE=mock
VITE_INSURER_URL=http://localhost:5174

# Isolated Midnight Lace connectivity spike. These are public service targets only.
VITE_MIDNIGHT_NETWORK=preprod
VITE_MIDNIGHT_PROOF_SERVER=http://localhost:6300
# Keep false for ordinary local/product builds. Set true only for an explicitly
# deployed engineering acceptance surface at /wallet-debug.
VITE_ENABLE_WALLET_DEBUG=false

# Never put PROVIDER_SECRET_KEY here. It belongs only to the attestor service.
