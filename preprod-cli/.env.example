# Local CLI-only secrets. Copy this file to .env; .env is gitignored.
# Generate this file with: npm run prepare-wallet --workspace @driveproof/preprod-cli
WALLET_MNEMONIC=

# Required to encrypt the CLI's local Midnight private-state database.
MIDNIGHT_STORAGE_PASSWORD=

# Public local service targets.
DRIVEPROOF_ATTESTOR_URL=http://localhost:4000
MIDNIGHT_PROOF_SERVER=http://localhost:6300

# Never place PROVIDER_SECRET_KEY, wallet seeds, or any other service secret here.
