// DriveProof Phase 3: subject binding + contract-local replay nullifier.
// Trusted attestor must issue unique attestationIds — a malicious attestor can still
// re-issue duplicate records under different IDs (known trust boundary).

pragma language_version >= 0.22 && <= 0.23;
import CompactStandardLibrary;
import "schnorr" prefix Schnorr_;

export { Schnorr_SchnorrSignature };

export new type DriverSecret = Bytes<32>;

struct SpeedReading {
    speed: Uint<16>;
    attestationId: Field;
}

export ledger attestors: Map<Uint<16>, JubjubPoint>;
export ledger speedLimit: Uint<16>;
export ledger complianceCount: Uint<32>;
export ledger usedNullifiers: Set<Field>;

witness getAttestedSpeedWitness(): [SpeedReading, Schnorr_SchnorrSignature, Uint<16>];
witness getDriverSecret(): DriverSecret;

constructor(limit: Uint<16>, attestorId: Uint<16>, attestorPk: JubjubPoint) {
    speedLimit = disclose(limit);
    attestors.insert(disclose(attestorId), disclose(attestorPk));
}

export pure circuit deriveDriverBinding(secret: DriverSecret): Field {
    const bindingBytes = persistentHash<[Bytes<21>, DriverSecret]>([
        "DRIVEPROOF_SUBJECT_V1",
        secret
    ]) as Bytes<32>;
    return transientHash<Bytes<32>>(bindingBytes);
}

export pure circuit deriveNullifier(attestationId: Field): Field {
    return transientHash<[Bytes<23>, Field]>([
        "DRIVEPROOF_NULLIFIER_V1",
        attestationId
    ]);
}

export circuit proveCompliance(): [] {
    const [reading, signature, attestorId] = getAttestedSpeedWitness();

    assert(attestors.member(disclose(attestorId)), "Attestor not registered");
    const attestorPk = attestors.lookup(disclose(attestorId));

    const driverBinding = deriveDriverBinding(getDriverSecret());
    const msg: Vector<3, Field> = [
        reading.speed as Field,
        driverBinding,
        reading.attestationId
    ];
    Schnorr_schnorrVerify<3>(msg, signature, attestorPk);

    assert(reading.speed <= speedLimit, "Speed exceeds policy limit");

    const nullifier = deriveNullifier(reading.attestationId);
    assert(!usedNullifiers.member(disclose(nullifier)), "Attestation already used");
    usedNullifiers.insert(disclose(nullifier));

    complianceCount = disclose((complianceCount + 1) as Uint<32>);
}

export pure circuit schnorrChallenge(
    ann_x: Field, ann_y: Field,
    pk_x: Field, pk_y: Field,
    msg: Vector<3, Field>
): Field {
    return Schnorr_schnorrChallenge3(ann_x, ann_y, pk_x, pk_y, msg);
}
