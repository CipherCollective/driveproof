{
  "name": "driveproof-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./managed/driveproof/contract": {
      "types": "./dist/managed/driveproof/contract/index.d.ts",
      "import": "./dist/managed/driveproof/contract/index.js",
      "default": "./dist/managed/driveproof/contract/index.js"
    }
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0"
  },
  "scripts": {
    "compact": "compact compile src/driveproof.compact src/managed/driveproof",
    "test": "vitest run",
    "test:compile": "npm run compact && vitest run",
    "build": "rm -rf dist && tsc --project tsconfig.build.json && cp -Rf ./src/managed ./dist/managed && cp ./src/driveproof.compact ./src/schnorr.compact ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
